# This file is a template. Binaries read from process environment, not from
# this file directly. Load it before running:
#   set -a; source .env; set +a; make run
# Or use docker-compose's env_file directive.

HTTP_ADDR=:8080
DB_DSN=postgres://postgres:postgres@localhost:5432/quotes?sslmode=disable
PROVIDER_API_KEY=
PROVIDER_BASE_URL=https://api.currencylayer.com
SCHEDULER_TICK_SECONDS=30
COALESCING_WINDOW_SECONDS=30
WORKER_COUNT=1
WHITELIST_CURRENCIES=USD,EUR,MXN
LOG_LEVEL=info

# REFRESH_MAX_LATENCY_MS is the contractual upper bound on p99 latency from
# accepted POST /quotes/refresh to status=done (integer milliseconds; default
# 2000). The worker's pollInterval and batchSize are *derived* from this value
# plus WHITELIST_CURRENCIES and WORKER_COUNT — they are not separate env vars.
# Effective values are logged at startup as "derived worker config". See
# docs/discussions/capacity.md > Refresh latency SLA for the formula. Must be
# >= 1000 (upstream_p99 + db_p99 + margin); the service refuses to start below
# that floor.
REFRESH_MAX_LATENCY_MS=2000

# APP_ENV controls profile-dependent behavior. Set to "production" to disable
# the kin-openapi runtime validation middleware. Default: development.
APP_ENV=development

# Fake rates provider (cmd/fakeprovider) — used for local dev and load testing
FAKE_ADDR=:9090
FAKE_SEED=42
FAKE_MONTHLY_QUOTA=100
FAKE_ACCESS_KEY=
